{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
		"source": "/home/matteogeraldo05/.config/fastfetch/images/soul_reaper.png",
		"width": 30,
		"padding": {
			"top": 3,
			"left": 2,
			"right": 4
		}
	},
	"display": {
		"separator": ""
	},
	"modules": [
		{
			"type": "title",
			"key": "USER     ▶ ",
			"keyColor": "38;2;173;216;230"
		},
		{
			"type": "custom",
			"format": "──────────────────────────────────────────────────",
			"outputColor": "38;2;150;150;150"
		},

		{
			"type": "os",
			"key": "OS       ▶ ",
			"keyColor": "38;2;173;216;230"
		},
		{
			"type": "kernel",
			"key": "KERNEL   ▶ ",
			"format": "{1} {2}",
			"keyColor": "38;2;173;216;230"
		},
		{
			"type": "de",
			"key": "DESKENV  ▶ ",
			"keyColor": "38;2;173;216;230"
		},
		{
			"type": "wm",
			"key": "WINMANGR ▶ ",
			"keyColor": "38;2;173;216;230"
		},
		{
			"type": "host",
			"key": "HOST     ▶ ",
			"format": "{2}",
			"keyColor": "38;2;173;216;230"
		},
		{
			"type": "uptime",
			"key": "UPTIME   ▶ ",
			"keyColor": "38;2;173;216;230"
		},
		{
			"type": "custom",
			"format": "──────────────────────────────────────────────────",
			"outputColor": "38;2;150;150;150"
		},

		{
			"type": "command",
			"key": "CPU      ▶ ",
			"keyColor": "38;2;173;216;230",
			"text": "lscpu | awk -F': +' '/^Model name/{n=$2} /^CPU max MHz/{f=$2} END{gsub(/Core\\(TM\\) ?/,\"\",n); gsub(/  +/,\" \",n); gsub(/^ +| +$/,\"\",n); printf \"%s @ %.2f GHz\", n, f/1000}'"
		},
		{
			"type": "gpu",
			"key": "GRAPHICS ▶ ",
			"format": "{vendor} {name} @ {frequency}",
			"keyColor": "38;2;173;216;230"
		},
		{
			"type": "memory",
			"key": "MEMORY   ▶ ",
			"keyColor": "38;2;173;216;230"
		},
		{
			"type": "disk",
			"key": "DISKS    ▶ ",
			"keyColor": "38;2;173;216;230"
		},
		{
			"type": "display",
			"key": "DISPLAY  ▶ ",
			"format": "{inch}\" {refresh-rate}Hz {width}x{height} {name}",
			"keyColor": "38;2;173;216;230"
		},
		{
			"type": "battery",
			"key": "BATTERY  ▶ ",
			"keyColor": "38;2;173;216;230"
		},
		{
			"type": "custom",
			"format": "──────────────────────────────────────────────────",
			"outputColor": "38;2;150;150;150"
		},

		{
			"type": "shell",
			"key": "SHELL    ▶ ",
			"keyColor": "38;2;173;216;230"
		},
		{
			"type": "terminal",
			"key": "TERMINAL ▶ ",
			"keyColor": "38;2;173;216;230"
		}
	]
}
